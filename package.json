    "@types/react": "19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "babel-preset-expo": "^54.0.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
